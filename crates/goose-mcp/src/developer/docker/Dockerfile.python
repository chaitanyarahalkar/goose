# Python-specific Goose sandbox image
FROM python:3.11-slim

# Install system dependencies
RUN apt-get update && apt-get install -y \
    git \
    curl \
    wget \
    build-essential \
    pkg-config \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Install common Python tools
RUN pip install --no-cache-dir \
    requests \
    numpy \
    pandas \
    pytest \
    black \
    flake8 \
    mypy \
    jupyterlab \
    poetry \
    pipenv

# Set up directories
RUN mkdir -p /workspace /home/goose
RUN useradd -u 1000 -m -s /bin/bash goose && \
    chown -R goose:goose /home/goose

WORKDIR /workspace
CMD ["/bin/bash"]