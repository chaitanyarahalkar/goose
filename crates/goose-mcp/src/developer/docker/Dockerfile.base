# Base Goose sandbox image with common development tools
FROM ubuntu:22.04

# Avoid prompts from APT
ENV DEBIAN_FRONTEND=noninteractive

# Install common development tools and languages
RUN apt-get update && apt-get install -y \
    # System utilities
    curl \
    wget \
    git \
    vim \
    nano \
    unzip \
    zip \
    tree \
    htop \
    procps \
    net-tools \
    iputils-ping \
    # Build tools
    build-essential \
    cmake \
    pkg-config \
    # Languages and runtimes
    python3 \
    python3-pip \
    nodejs \
    npm \
    openjdk-11-jdk \
    # Shell and scripting
    bash \
    zsh \
    fish \
    jq \
    # Network tools (for open profiles)
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Set up common directories
RUN mkdir -p /workspace /home/goose

# Create a non-root user for running commands
RUN useradd -u 1000 -m -s /bin/bash goose && \
    chown -R goose:goose /home/goose

# Set working directory
WORKDIR /workspace

# Default shell
CMD ["/bin/bash"]